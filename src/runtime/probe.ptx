// P1 driver probe, not a physics kernel.
.version 6.0
.target sm_70
.address_size 64

.visible .entry affine_probe(
    .param .u64 input_ptr,
    .param .u64 output_ptr,
    .param .u32 elements
)
{
    .reg .pred %p;
    .reg .u32 %r<5>;
    .reg .u64 %rd<6>;
    .reg .f32 %f<3>;

    ld.param.u64 %rd1, [input_ptr];
    ld.param.u64 %rd2, [output_ptr];
    ld.param.u32 %r4, [elements];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r1, %r1, %r2, %r3;
    setp.ge.u32 %p, %r1, %r4;
    @%p bra done;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd5, %rd2, %rd3;
    ld.global.f32 %f1, [%rd4];
    mul.rn.f32 %f2, %f1, 0f40000000;
    add.rn.f32 %f2, %f2, 0f3F800000;
    st.global.f32 [%rd5], %f2;
done:
    ret;
}
