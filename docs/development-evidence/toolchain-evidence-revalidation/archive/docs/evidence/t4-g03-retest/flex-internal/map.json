  "steps": [
    {
      "id": "node-transform",
      "classification": "same-scalar-order-unverified",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_nodes",
      "upstream_type": "wp.vec3",
      "product": [
        "bool zero=local[0]==0.0f&&local[1]==0.0f&&local[2]==0.0f;",
        "flex_transform(nx+3*i,local,xp,xm,nodebody[i],row[8]!=0||zero);",
        "((r[3*k]*local[0]+r[3*k+1]*local[1])+r[3*k+2]*local[2])+p[k];"
      ],
      "upstream": [
        "if flex_centered[f]:",
        "if local_pos[0] == 0.0 and local_pos[1] == 0.0 and local_pos[2] == 0.0:",
        "flexnode_xpos_out[worldid, nodeid] = xmat @ local_pos + xpos"
      ]
    },
    {
      "id": "vertex-direct",
      "classification": "same-scalar-order-unverified",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_vertices",
      "upstream_type": "wp.vec3",
      "product": [
        "if(row[0]==0) { flex_transform(vx+3*v,verts+3*v,xp,xm,vertbody[v],row[8]!=0);continue; }"
      ],
      "upstream": [
        "if flex_centered[f]:",
        "flexvert_xpos_out[worldid, vertid] = xmat @ local_pos + xpos"
      ]
    },
    {
      "id": "cell-lookup",
      "classification": "f32-to-i32",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_vertices",
      "upstream_type": "float",
      "product": [
        "float coord=coords[3*v+k]*(float)row[1+k];",
        "cell[k]=max(0,min((int)coord,row[1+k]-1));"
      ],
      "upstream": [
        "ci = wp.min(int(coord[0] * float(cx)), cx - 1)",
        "ci = wp.max(ci, 0)"
      ]
    },
    {
      "id": "local-clamp",
      "classification": "finite-domain",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_vertices",
      "upstream_type": "wp.vec3",
      "product": [
        "float local[3];",
        "local[k]=fminf(1.0f,fmaxf(0.0f,coord-(float)cell[k]));"
      ],
      "upstream": [
        "local_x = wp.clamp(coord[0] * float(cx) - float(ci), 0.0, 1.0)",
        "local = wp.vec3(local_x, local_y, local_z)"
      ]
    },
    {
      "id": "basis",
      "classification": "same-scalar-order-unverified",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/support.py",
      "symbol": "eval_basis_trilinear",
      "upstream_type": "float",
      "product": [
        "float weight=(i?local[0]:1-local[0])*(j?local[1]:1-local[1])*(k?local[2]:1-local[2]);"
      ],
      "upstream": [
        "return _phi(local[0], i) * _phi(local[1], j) * _phi(local[2], k)"
      ]
    },
    {
      "id": "interpolate",
      "classification": "same-loop-order",
      "scalar": "f32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_vertices",
      "upstream_type": "wp.vec3",
      "product": [
        "float p[3]={0,0,0};",
        "for(int i=0;i<2;++i) for(int j=0;j<2;++j) for(int k=0;k<2;++k)",
        "for(int d=0;d<3;++d) p[d]+=weight*nx[3*n+d];"
      ],
      "upstream": [
        "result = wp.vec3(0.0, 0.0, 0.0)",
        "for li in range(2):",
        "for lj in range(2):",
        "for lk in range(2):",
        "result += w * flexnode_xpos_in[worldid, nstart + node_idx]"
      ]
    },
    {
      "id": "invalidate",
      "classification": "private-bool-adapter",
      "scalar": "i32",
      "source": "src/physics/flex.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "flex",
      "upstream_type": "bool",
      "product": [
        "int* flags=result+4+(unsigned long long)w*nf;",
        "for(int f=0;f<nf;++f) flags[f]=0;"
      ],
      "upstream": [
        "if m.nflex > 0:",
        "d.flex_hessian_valid.zero_()"
      ]
    },
    {
      "id": "edge-difference",
      "classification": "same-scalar",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "wp.vec3",
      "product": [
        "float dir[3];for(int k=0;k<3;++k) dir[k]=vx[3*v2+k]-vx[3*v1+k];"
      ],
      "upstream": [
        "vec = pos2 - pos1",
        "edge, edge_length = math.normalize_with_norm(vec)"
      ]
    },
    {
      "id": "edge-length",
      "classification": "same-scalar-order-unverified",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/math.py",
      "symbol": "normalize_with_norm",
      "upstream_type": "float",
      "product": [
        "float norm=sqrtf((dir[0]*dir[0]+dir[1]*dir[1])+dir[2]*dir[2]);len[e]=norm;"
      ],
      "upstream": [
        "norm = wp.length(x)"
      ]
    },
    {
      "id": "edge-normalize",
      "classification": "zero-preserved",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/math.py",
      "symbol": "normalize_with_norm",
      "upstream_type": "wp.vec3",
      "product": [
        "if(norm!=0.0f) for(int k=0;k<3;++k) dir[k]/=norm;"
      ],
      "upstream": [
        "if norm == 0.0:",
        "return x, 0.0",
        "return x / norm, norm"
      ]
    },
    {
      "id": "edge-offset",
      "classification": "same-scalar",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "wp.vec3",
      "product": [
        "float off[2][3];",
        "off[s][k]=vx[3*(s?v2:v1)+k]-sc[3*root[bodies[s]]+k];"
      ],
      "upstream": [
        "offset1 = pos1 - com1",
        "offset2 = pos2 - com2"
      ]
    },
    {
      "id": "point-velocity",
      "classification": "same-scalar-order-unverified",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "wp.vec3",
      "product": [
        "float p[3]={cd[3]+(cd[1]*o[2]-cd[2]*o[1]),",
        "cd[4]+(cd[2]*o[0]-cd[0]*o[2]),cd[5]+(cd[0]*o[1]-cd[1]*o[0])};"
      ],
      "upstream": [
        "jacp1 = cdof_lin + wp.cross(cdof_ang, offset1)",
        "jacp2 = cdof_lin + wp.cross(cdof_ang, offset2)"
      ]
    },
    {
      "id": "jacobian",
      "classification": "same-endpoint-order",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "float",
      "product": [
        "float j=0.0f;",
        "float dot=(p[0]*dir[0]+p[1]*dir[1])+p[2]*dir[2];j+=s?dot:-dot;",
        "jac[adr+i]=j;"
      ],
      "upstream": [
        "J_val = float(0.0)",
        "J_val -= wp.dot(jacp1, edge)",
        "J_val += wp.dot(jacp2, edge)",
        "flexedge_J_out[worldid, rowadr + i] = J_val"
      ]
    },
    {
      "id": "edge-velocity",
      "classification": "same-row-order",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "float",
      "product": [
        "vel[e]=0.0f;",
        "vel[e]+=j*qv[d];"
      ],
      "upstream": [
        "vel = float(0.0)",
        "vel += J_val * qvel_in[worldid, dofid]",
        "flexedge_velocity_out[worldid, edgeid] = vel"
      ]
    },
    {
      "id": "sparse-pool",
      "classification": "extra-tail-clear",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "float",
      "product": [
        "for(int i=0;i<nnz;++i) jac[i]=0.0f;"
      ],
      "upstream": [
        "for i in range(rownnz):",
        "flexedge_J_out[worldid, rowadr + i] = J_val"
      ]
    },
    {
      "id": "edge-early-return",
      "classification": "same-velocity-only",
      "scalar": "f32",
      "source": "src/physics/flex_edge.rs",
      "external": "upstream/_src/smooth.py",
      "symbol": "_flex_edges",
      "upstream_type": "float",
      "product": [
        "if(b1<0||b2<0||num==0) continue;"
      ],
      "upstream": [
        "if b1 < 0 or b2 < 0 or rownnz == 0:",
        "flexedge_velocity_out[worldid, edgeid] = 0.0",
        "return"
      ]
    }
  ],
