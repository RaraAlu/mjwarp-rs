    "ownership_rules_zh": [
        "宿主输入独占其字段；设备模型独占只读批次；阶段计划独占常量与元数据证明。",
        "阶段 Data 独占世界状态与工作区；计划只借用，不取得所有权。",
        "任何设备缓冲都绑定唯一 TransferSession；跨会话使用一律拒绝。",
        "拓扑与布局身份固定：同尺寸不代表同拓扑，身份不符即拒。",
        "证明与写入代际绑定；失效后必须先重建证明再发射。",
        "发布结果前完成守卫检查、非有限检查与状态核对；失败不发布部分结果。"
    ],
    "data_contract_zh": {
        "layout": [
            "全部批量字段使用 BatchLayout：世界数 × 每世界元素数 × 元素字节。",
            "受保护缓冲在首尾各留四个哨兵槽，共八槽；精确跨度按 8 + 世界数 × 字段步长。",
            "多阶段工作区按字段拼接同一世界步长；结果缓冲可宽于最小写入宽度，按最小容量校对。"
        ],
        "lifecycle": [
            "构造期：检查宿主输入 → 上传模型/参数/元数据 → 建立证明。",
            "运行期：每阶段先核对身份、会话、证明与精确跨度，再同步发射。",
            "失效：状态写入使派生结果失效；元数据写入使证明代际失效。",
            "销毁：设备缓冲随所属类型 Drop；会话保证完成事件，不遗留不确定状态。"
        ],
        "batching": [
            "世界批量 W 独立推进；单世界可局部写入。",
            "字段批量 B_f 按周期共享参数；批量下标 = 世界序号对周期取模。",
            "拓扑与映射只存一份，不随世界复制；设备元数据按世界登记状态。"
        ],
        "public_compat": [
            "保留 io::DeviceKinematicModel 与 io::DeviceInertialModel 公开路径作为兼容门面。",
            "保留各阶段 Plan/Data 的公开构造与更新入口；model::data 迁移不改变这些签名。",
            "model::data 目标归属只新增共享布局/批量/生命周期契约；不整体搬迁目录。"
        ]
    },
