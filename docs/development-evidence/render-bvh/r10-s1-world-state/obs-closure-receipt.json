    },
    "F3": {
      "problem": "WorldLayout::resolve 先做 OutputLayout::resolve，nworld==0 的错误被布局错误遮蔽",
      "fix": "nworld==0 判定提到 OutputLayout::resolve 之前（错误优先级写死）",
      "test": "nworld_zero_has_priority_over_layout_errors（构造 OutputLayout 会失败的 plan：nworld=0 → WorldCountZero；nworld=2 → Layout(..)）"
    }
