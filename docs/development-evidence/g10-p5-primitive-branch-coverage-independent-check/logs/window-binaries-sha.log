 '=== window binary sha (target/debug/deps) vs window facts'; foreach($n in 'g10_p5_primitive_branches_cuda','g10_p5_primitive_plane_cuda','g10_p5_primitive_sphere_capsule_cuda','g10_p5_primitive_cuda','g10_p5_nvrtc_launcher'){ Get-ChildItem target\debug\deps -Filter "$n-*.exe" | ForEach-Object { "$n $($_.Name) $((Get-FileHash -Algorithm SHA256 $_.FullName).Hash.ToLower())" } } 
