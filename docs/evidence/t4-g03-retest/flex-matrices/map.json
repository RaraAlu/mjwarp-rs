        "float denom=fabsf((face_dot(R[0],F[0])+face_dot(R[1],F[1]))+face_dot(R[2],F[2]))+1.0e-10f;",
        "omega[k]=((crosses[0][k]+crosses[1][k])+crosses[2][k])/denom;"
