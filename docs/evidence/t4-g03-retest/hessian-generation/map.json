  "prerequisites": [
    {
      "source": "version",
      "symbol": "check_version",
      "anchors": [
        "installed_str = importlib.metadata.version(package_name)",
        "installed_version = _parse_version(installed_str)",
        "return ops[op](installed_version, required_version)"
      ]
    },
    {
      "source": "passive",
      "symbol": "flex_hessian",
      "anchors": [
        "if m.nflex == 0:\n    return",
        "nclear = max(m.nflexvert, m.nflexedge)",
        "if nclear > 0:",
        "dim=(d.nworld, nclear)",
        "if m.nflexelem > 0:",
        "dim=(d.nworld, m.nflexelem)",
        "dim=(d.nworld, m.nflexedge)",
        "d.flex_hessian_valid.fill_(True)"
      ],
      "ordered": [
        "_flex_hessian_clear,",
        "_flex_hessian_elem,",
        "_flex_hessian_diag,",
        "d.flex_hessian_valid.fill_(True)"
      ]
    },
    {
      "source": "passive",
      "symbol": "_flex_hessian_active",
      "anchors": [
        "if f < 0:",
        "flex_interp[f] != 0 or flex_rigid[f] or flex_dim[f] < 2",
        "if stiffness_adr < 0:",
        "return flex_stiffness[stiffness_adr] != 0.0"
      ]
    },
    {
      "source": "passive",
      "symbol": "_flex_hessian_elem",
      "anchors": [
        "if flex_hessian_valid_in[worldid, f]:",
        "if not _flex_hessian_active(",
        "local_elemid * (FLEX_STIFFNESS_3D if dim == 3 else 21)",
        "snh = wp.static(FLEX_STIFFNESS_3D == 24) and dim == 3 and flex_stiffness[stiffness_adr + 21] != 0.0"
      ]
    },
    {
      "source": "types",
      "anchors": [
        "FLEX_STIFFNESS_3D = 24 if util_pkg.check_version(\"mujoco>=3.14.1.dev989511280\") else 21",
        "flex_hessian_valid: array(\"nworld\", \"nflex\", bool)"
      ]
    },
    {
      "source": "metadata",
      "anchors": [
        "Name: mujoco\nVersion: 3.15.0\n"
      ]
    },
    {
      "source": "io",
      "anchors": [
        "m.has_flex_snh = bool(",
        "types.FLEX_STIFFNESS_3D == 24",
        "and mjm.flex_dim[f] == 3",
        "and mjm.flex_elemnum[f] > 0",
        "raise ValueError(\"stable Neo-Hookean elasticity requires integrator='discrete'\")"
      ]
    },
    {
      "source": "derivative",
      "symbol": "eff_build",
      "anchors": [
        "if m.opt.integrator != IntegratorType.DISCRETE:",
        "if m.nflex > 0 and not ((m.opt.disableflags & DisableBit.SPRING) and (m.opt.disableflags & DisableBit.DAMPER)):",
        "passive.flex_hessian(m, d)"
      ]
    },
    {
      "source": "model",
      "anchors": [
        "positions.flex_interp[f] == 0",
        "&& !self.flex_rigid[f]",
        "&& self.flex_dim[f] >= 2",
        "let width = count.checked_mul(21)"
      ]
    }
  ],
  "accumulation": [
    {
      "source": "passive",
      "symbol": "_flex_hessian_elem",
      "anchors": [
        "worldid, elemid = wp.tid()",
        "wp.atomic_add(flexedge_hessian_out, worldid, edge_id, block)"
      ]
    },
    {
      "source": "passive",
      "symbol": "_flex_hessian_diag",
      "anchors": [
        "worldid, edgeid = wp.tid()",
        "d0 = vec6(-block[0, 0]",
        "wp.atomic_add(flexvert_hessian_out, worldid, va + vert[0], d0)",
        "wp.atomic_add(flexvert_hessian_out, worldid, va + vert[1], d1)"
      ]
    },
    {
      "source": "matrix",
      "anchors": [
        "m.data[i][j] = atomic_add(&addr->data[i][j], value.data[i][j]);"
      ]
    },
    {
      "source": "vector",
      "anchors": [
        "ret[i] = atomic_add(&(addr->c[i]), value[i]);"
      ]
    },
    {
      "source": "builtin",
      "anchors": [
        "template <typename T> inline CUDA_CALLABLE T atomic_add(T* buf, T value)",
        "return atomicAdd(buf, value);"
      ]
    },
    {
      "source": "passive",
      "symbol": "stretch_stiffness_block",
      "anchors": [
        "if sa != 0.0 and sb != 0.0:",
        "geo += tension[a] * sa * sb",
        "geo *= scale"
      ]
    },
    {
      "source": "product",
      "anchors": [
        "for(int el=0;el<r[7];++el)",
        "blocks[9*edge+k]+=block[k]",
