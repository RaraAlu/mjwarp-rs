      "id": "site-load",
      "p_source": 0,
      "product": "put(scratch+13*i+1,sl(sx+3*site[i]));",
      "u_source": 3,
      "upstream": "pnt0 = site_xpos_in[worldid, id0]"
    },
    {
      "id": "site-length",
      "p_source": 0,
      "product": "out[t]+=norm(sub(point(scratch,i+1),point(scratch,i)))*scales[i];",
      "u_source": 3,
      "upstream": "wp.atomic_add(ten_length_out[worldid], tenid, length * pulley_scale)"
    },
    {
      "id": "segment-difference",
      "p_source": 0,
      "product": "SV dif=sub(p1,p0);",
      "u_source": 3,
      "upstream": "dif = pnt1 - pnt0"
    },
    {
      "id": "unit-zero",
      "p_source": 1,
      "product": "return n!=0 ? SV{a.x/n,a.y/n,a.z/n} : a;",
      "u_source": 4,
      "upstream": "return x, 0.0"
    },
    {
      "id": "tiny-direction",
      "p_source": 1,
      "product": "return n<1e-15f ? SV{1,0,0} : SV{a.x/n,a.y/n,a.z/n};",
      "u_source": 3,
      "upstream": "vec = wp.vec3(1.0, 0.0, 0.0)"
    },
    {
      "id": "same-body",
      "p_source": 0,
      "product": "if(b0==b1) return;",
      "u_source": 3,
      "upstream": "if body0 != body1:"
    },
    {
      "id": "root-offset-0",
      "p_source": 0,
      "product": "sub(p0,sl(com+m[3]+3*root[b0]))",
      "u_source": 3,
      "upstream": "offset0 = pnt0 - subtree_com_in[worldid, body_rootid[body0]]"
    },
    {
      "id": "root-offset-1",
      "p_source": 0,
      "product": "sub(p1,sl(com+m[3]+3*root[b1]))",
      "u_source": 3,
      "upstream": "offset1 = pnt1 - subtree_com_in[worldid, body_rootid[body1]]"
    },
    {
      "id": "reverse-dof",
      "p_source": 0,
      "product": "for(int k=dofnum[body]-1;k>=0;--k)",
      "u_source": 3,
      "upstream": "dof = bdofadr + bdofnum - 1 - k_rev"
    },
    {
      "id": "sparse-match",
      "p_source": 0,
      "product": "cols[row+ptr]==dof",
      "u_source": 3,
      "upstream": "ten_J_colind[sparseid] == dof"
    },
    {
      "id": "angular-cross",
      "p_source": 0,
      "product": "SV v=cross(sl(c),offset);",
      "u_source": 3,
      "upstream": "jacp = cdof_lin + wp.cross(cdof_ang, offset)"
    },
    {
      "id": "projection",
      "p_source": 0,
      "product": "float j=((c[3]+v.x)*vec.x+(c[4]+v.y)*vec.y+(c[5]+v.z)*vec.z)*scale;",
      "u_source": 3,
      "upstream": "J = wp.dot(jacp, vec) * scale"
    },
    {
      "id": "skip-zero",
      "p_source": 0,
      "product": "if(j!=0.0f) jac[row+ptr]+=j;",
      "u_source": 3,
      "upstream": "if J != 0.0:"
    },
    {
      "id": "serial-vs-atomic",
      "p_source": 0,
      "product": "jac[row+ptr]+=j;",
      "u_source": 3,
      "upstream": "wp.atomic_add(ten_J_out[worldid], sparseid, J)"
    },
    {
      "id": "pulley-sentinel",
      "p_source": 0,
      "product": "out[2*nt+cursor++]=type[i]==2?-2:-1;",
      "u_source": 3,
      "upstream": "wrap_obj_out[worldid, row][col] = -2"
    },
    {
      "id": "wrap-count",
      "p_source": 0,
      "product": "out[nt+t]=cursor-out[t];",
      "u_source": 3,
      "upstream": "ten_wrapadr_out[worldid, i] = wrapcount"
    }
  ],
