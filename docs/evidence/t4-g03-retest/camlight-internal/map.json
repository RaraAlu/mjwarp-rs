      "id": "camera-fixed-position",
      "physical_scalar": "f32",
      "product": "V pos=add(load_v(xp+3*b),rotate(q,load_v(cp+3*c)));",
      "upstream": "cam_xpos_out[worldid, camid] = xpos + math.rot_vec_quat(cam_pos[cam_pos_id, camid], xquat)"
    },
    {
      "id": "camera-track-position",
      "physical_scalar": "f32",
      "product": "if(mode==1) pos=add(load_v(xp+3*b),load_v(cp0+3*c));",
      "upstream": "cam_xpos_out[worldid, camid] = body_xpos + cam_pos0[worldid % cam_pos0.shape[0], camid]"
    },
    {
      "id": "camera-track-matrix",
      "physical_scalar": "f32",
      "product": "if(mode==1 || mode==2)",
      "upstream": "cam_xmat_out[worldid, camid] = cam_mat0[worldid % cam_mat0.shape[0], camid]"
    },
    {
      "id": "camera-trackcom",
      "physical_scalar": "f32",
      "product": "if(cm[c]==2) store_v(cx+3*c,add(load_v(sc+3*cb[c]),load_v(cpc+3*c)));",
      "upstream": "subtree_com_in[worldid, cam_bodyid[camid]] + cam_poscom0[worldid % cam_poscom0.shape[0], camid]"
    },
    {
      "id": "camera-fixed-or-invalid-target",
      "physical_scalar": "f32",
      "product": "else matrix(mx+9*c,multiply(q,load_q(cq+4*c)));",
      "upstream": "cam_xmat_out[worldid, camid] = math.quat_to_mat(math.mul_quat(xquat, cam_quat[cam_quat_id, camid]))"
    },
    {
      "id": "camera-target-body",
      "physical_scalar": "f32",
      "product": "else if(mode==3 && t>=0) look_at(mx+9*c,pos,load_v(xp+3*t));",
      "upstream": "pos = xpos_in[worldid, cam_targetbodyid[camid]]"
    },
    {
      "id": "camera-target-com",
      "physical_scalar": "f32",
      "product": "else if(cm[c]==4 && ct[c]>=0) look_at(mx+9*c,load_v(cx+3*c),load_v(sc+3*ct[c]));",
      "upstream": "pos = subtree_com_in[worldid, cam_targetbodyid[camid]]"
    },
    {
      "id": "camera-look-z",
      "physical_scalar": "f32",
      "product": "V z=light_normalize(add(pos,scale(target,-1.0f)));",
      "upstream": "mat_3 = wp.normalize(cam_xpos_out[worldid, camid] - pos)"
    },
    {
      "id": "camera-look-x",
      "physical_scalar": "f32",
      "product": "V x=light_normalize(light_cross(V{0,0,1},z));",
      "upstream": "mat_1 = wp.normalize(wp.cross(wp.vec3(0.0, 0.0, 1.0), mat_3))"
    },
    {
      "id": "camera-look-y",
      "physical_scalar": "f32",
      "product": "V y=light_normalize(light_cross(z,x));",
      "upstream": "mat_2 = wp.normalize(wp.cross(mat_3, mat_1))"
    },
    {
      "id": "light-fixed-position",
      "physical_scalar": "f32",
      "product": "V pos=add(load_v(xp+3*b),rotate(q,load_v(lp+3*l)));",
      "upstream": "light_xpos_out[worldid, lightid] = xpos + math.rot_vec_quat(light_pos[light_pos_id, lightid], xquat)"
    },
    {
      "id": "light-track-position",
      "physical_scalar": "f32",
      "product": "if(mode==1) pos=add(load_v(xp+3*b),load_v(lp0+3*l));",
      "upstream": "light_xpos_out[worldid, lightid] = body_xpos + light_pos0[worldid % light_pos0.shape[0], lightid]"
    },
    {
      "id": "light-fixed-direction",
      "physical_scalar": "f32",
      "product": "V dir=rotate(q,load_v(ld+3*l));",
      "upstream": "light_xdir_out[worldid, lightid] = math.rot_vec_quat(light_dir[light_dir_id, lightid], xquat)"
    },
    {
      "id": "light-track",
      "physical_scalar": "f32",
      "product": "if(mode==1 || mode==2) dir=load_v(ld0+3*l);",
      "upstream": "light_xdir_out[worldid, lightid] = light_dir0[worldid % light_dir0.shape[0], lightid]"
    },
    {
      "id": "light-trackcom",
      "physical_scalar": "f32",
      "product": "if(lm[l]==2) store_v(lx+3*l,add(load_v(sc+3*lb[l]),load_v(lpc+3*l)));",
      "upstream": "subtree_com_in[worldid, light_bodyid[lightid]] + light_poscom0[worldid % light_poscom0.shape[0], lightid]"
    },
    {
      "id": "light-target-body",
      "physical_scalar": "f32",
      "product": "else if(mode==3 && t>=0) dir=add(load_v(xp+3*t),scale(pos,-1.0f));",
      "upstream": "pos = xpos_in[worldid, light_targetbodyid[lightid]]"
    },
    {
      "id": "light-target-com",
      "physical_scalar": "f32",
      "product": "store_v(dx+3*l,light_normalize(add(load_v(sc+3*lt[l]),scale(load_v(lx+3*l),-1.0f))));",
      "upstream": "pos = subtree_com_in[worldid, light_targetbodyid[lightid]]"
    },
    {
      "id": "light-normalization-exception",
      "physical_scalar": "f32",
      "product": "store_v(dx+3*l,invalid ? dir : light_normalize(dir));",
      "upstream": "light_xdir_out[worldid, lightid] = wp.normalize(light_xdir_out[worldid, lightid])"
    }
