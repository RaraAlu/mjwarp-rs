<mujoco model="g24-history">
  <option timestep="0.01"/>
  <worldbody>
    <body name="body" pos="0 0 0">
      <joint name="slide" type="slide"/>
      <geom name="geom" size="0.1" mass="1"/>
      <body name="child" pos="1 0 0">
        <joint name="slide2" type="slide"/>
        <geom name="geom2" size="0.1" mass="1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="slide" delay="0.02" nsample="3"/>
    <motor joint="slide2" delay="0.01" nsample="2" interp="linear"/>
    <motor joint="slide2"/>
  </actuator>
  <sensor>
    <jointpos joint="slide" delay="0.02" nsample="3"/>
    <jointvel joint="slide2" interval="0.05 -0.02" nsample="4"/>
    <jointvel joint="slide" interval="0.03 0" nsample="2"/>
  </sensor>
</mujoco>
