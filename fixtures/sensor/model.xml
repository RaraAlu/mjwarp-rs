<mujoco model="sensor_input">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="arm" pos="0 0 0">
      <joint name="hinge" type="hinge" axis="0 1 0"/>
      <geom name="arm_geom" type="capsule" size="0.05 0.1" pos="0 0 -0.1"/>
      <body name="ball_body" pos="0 0 -0.2">
        <joint name="ball" type="ball"/>
        <geom name="ball_geom" type="sphere" size="0.05"/>
      </body>
    </body>
    <body name="slider" pos="1 0 0">
      <joint name="slide" type="slide" axis="1 0 0"/>
      <geom name="slider_geom" type="box" size="0.05 0.05 0.05"/>
    </body>
  </worldbody>
  <sensor>
    <jointpos name="hinge_pos" joint="hinge"/>
    <jointpos name="slide_pos" joint="slide" cutoff="0.4"/>
    <jointvel name="hinge_vel" joint="hinge"/>
    <jointvel name="slide_vel" joint="slide"/>
    <ballquat name="ball_quat" joint="ball"/>
    <clock name="clock"/>
  </sensor>
</mujoco>
