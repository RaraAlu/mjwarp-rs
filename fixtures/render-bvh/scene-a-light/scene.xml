<mujoco model="scene-a">
  <!-- Render/BVH S0a reference fixture: covers render-relevant model arrays.
       Same XML must compile to equivalent models with MuJoCo 3.12.0 (product)
       and 3.15.0 (reference authoring); parity is checked field by field. -->
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global fovy="45" offwidth="320" offheight="240"/>
    <quality shadowsize="1024" offsamples="4"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" active="1"/>
    <map znear="0.01" zfar="50" fogstart="1" fogend="10" haze="0.1"/>
  </visual>
  <statistic center="0.1 -0.2 0.3" extent="2.5"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.85 0.15 0.15" rgb2="0.15 0.15 0.85"
             width="64" height="64" colorspace="sRGB"/>
    <texture name="ramp" type="2d" builtin="gradient"
             rgb1="0.2 0.7 0.3" rgb2="0.05 0.1 0.2"
             width="32" height="32"/>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.4 0.6 0.9" rgb2="0.05 0.05 0.1"
             width="64" height="64"/>
    <material name="mat-red" texture="grid" texrepeat="2 3" texuniform="false"
              rgba="0.9 0.1 0.1 1" emission="0.05" specular="0.4"
              shininess="0.6" reflectance="0.1" metallic="0.2" roughness="0.3"/>
    <material name="mat-green" texture="ramp" texrepeat="1 1" texuniform="true"
              rgba="0.2 0.8 0.2 1" specular="0.2" shininess="0.1"
              reflectance="0.0" metallic="0.0" roughness="0.8"/>
    <material name="mat-plain" rgba="0.5 0.5 0.55 1" specular="0.1" shininess="0.2"/>
    <mesh name="tri" vertex="0 0 0  0.22 0 0  0 0.18 0.05  0 0 0.2" face="0 1 2  0 1 3  1 2 3  0 2 3"/>
  </asset>

  <worldbody>
    <!-- cam-persp is the perspective/intrinsics path: MuJoCo only fills
         cam_intrinsic when sensorsize comes with focal/principal, otherwise
         cam_fovy stays at the 180-degree sentinel and MJWarp's compute_ray
         divides by fx=0, so the whole camera would render background only.
         focalpixel 160px on a 320px sensor gives fx=0.018, fy=0.016, fovy 73.74. -->
    <camera name="cam-persp" pos="1.2 -1.1 0.8" quat="0.9 0.1 -0.2 0.3"
            resolution="320 240" sensorsize="0.036 0.024" focalpixel="160 160"
            projection="perspective"/>
    <camera name="cam-hinge" pos="-0.0925 0.4981 0.8296" quat="-0.211088 -0.149763 0.558924 0.787792"
            fovy="30" resolution="320 240"/>
    <camera name="cam-track" mode="targetbody" target="tri_body"
            pos="-0.8 0.9 0.7" fovy="40" resolution="240 180"/>

    <geom name="floor" type="plane" size="2 2 0.1" material="mat-plain"
          pos="0 0 0" quat="1 0 0 0" group="1" rgba="0.5 0.5 0.55 1"/>
    <body name="base" pos="0.1 -0.2 0.3" quat="0.96 0.1 -0.05 0.25">
      <freejoint name="basefree"/>
      <geom name="base-box" type="box" size="0.18 0.14 0.1" material="mat-red"
            pos="0.05 -0.02 0.03" quat="0.99 0.02 0.05 -0.1" group="2"
            rgba="0.85 0.25 0.2 1"/>
      <geom name="base-sphere" type="sphere" size="0.09" material="mat-green"
            pos="-0.12 0.08 0.05" group="2"/>
      <body name="tri_body" pos="0.2 0.1 0.25" quat="0.92 -0.1 0.2 0.3">
        <joint name="tri-hinge" type="hinge" pos="0 0 0" axis="0 0 1"/>
        <!-- scene-a-light variant: the three scene-a lights are attached to tri_body
             (MJCF attaches by nesting; there is no light "body" attribute), so the
             per-world hinge rotation moves light poses. All light attributes are
             byte-identical to scene-a/scene.xml. -->
        <light name="sun" type="directional" pos="1 1 3" dir="-0.5 -0.4 -1"
               diffuse="0.8 0.8 0.8" specular="0.25 0.25 0.25" ambient="0.1 0.1 0.1"
               castshadow="true" active="true" bulbradius="0.04" intensity="1.5" range="6"/>
        <light name="lamp" type="point" pos="0.4 0.5 1.2"
               diffuse="0.7 0.5 0.3" specular="0.2 0.2 0.2" ambient="0.02 0.02 0.02"
               attenuation="1 0.12 0.01" cutoff="20" exponent="8"
               castshadow="false" active="true" bulbradius="0.03" intensity="2.5" range="4"/>
        <light name="spot" type="spot" pos="0 0 2" dir="0 0 -1"
               diffuse="0.4 0.4 0.9" specular="0.1 0.1 0.3" ambient="0.01 0.01 0.02"
               attenuation="1 0.05 0.005" cutoff="30" exponent="6" softness="0.2"
               castshadow="true" active="true" bulbradius="0.05" intensity="1.0" range="5"/>
        <geom name="tri-mesh" type="mesh" mesh="tri" material="mat-red"
              pos="0 0 0" quat="1 0 0 0" group="3"/>
        <geom name="tri-capsule" type="capsule" size="0.05 0.12"
              pos="0.15 0 0" quat="0.707 0 0.707 0" material="mat-plain" group="1"/>
        <geom name="tri-cyl" type="cylinder" size="0.06 0.05"
              pos="-0.15 0.05 0" material="mat-green" group="1"/>
        <geom name="tri-ellip" type="ellipsoid" size="0.06 0.04 0.03"
              pos="0 -0.15 0" material="mat-plain" group="1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
