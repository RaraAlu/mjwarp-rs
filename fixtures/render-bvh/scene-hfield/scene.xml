<mujoco model="scene-hfield">
  <!-- R05-S3a hfield reference fixture (group 1: hfield-only).
       Offline authoring only: the pinned MJWarp 3.15 capture script reads this
       scene and writes under fixtures/render-bvh/scene-hfield/capture-hfield/.
       Terrain: 4x4 height field with non-zero size[2]; the elevation grid mixes
       one perturbed interior sample (non-coplanar cells -> no merge) with a
       planar ramp elsewhere (coplanar cells -> greedy merge), see the task
       evidence README for the f32 threshold reverse-calculation.
       Geometry: hfield is local, identity pose, z-up; two cameras (top-down and
       side) plus one static box occluder only in scene-mixed.xml. -->
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global fovy="45" offwidth="320" offheight="240"/>
    <quality shadowsize="1024" offsamples="4"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" active="1"/>
    <map znear="0.01" zfar="50" fogstart="1" fogend="10" haze="0.1"/>
  </visual>
  <statistic center="0 0 0.15" extent="2.5"/>

  <asset>
    <texture name="terrain-tex" type="2d" builtin="checker"
             rgb1="0.85 0.15 0.15" rgb2="0.15 0.15 0.85"
             width="64" height="64" colorspace="sRGB"/>
    <material name="mat-terrain" texture="terrain-tex" texrepeat="2 2" texuniform="false"
              rgba="0.9 0.9 0.9 1" specular="0.2" shininess="0.4"/>
    <material name="mat-plain" rgba="0.5 0.5 0.55 1" specular="0.1" shininess="0.2"/>
    <!-- 4x4 elevation (row-major). Base is a planar ramp 0.20*r + 0.35*c (row and
         column coefficients differ on purpose: the effective upstream grid must be
         distinguishable from its transpose, so a host/device row-column swap cannot
         hide behind a symmetric height field). One interior sample (r=2,c=1) is
         raised to 1.05 (+0.30) so the four cells around it are non-coplanar while
         the other five cells stay coplanar and merge. MuJoCo normalizes the grid to
         [0,1] on load (max was 1.65). -->
    <hfield name="terrain" nrow="4" ncol="4" size="1.5 1.0 0.25 0.1"
            elevation="0.00 0.35 0.70 1.05
                       0.20 0.55 0.90 1.25
                       0.40 1.05 1.10 1.45
                       0.60 0.95 1.30 1.65"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="1 1 3" dir="-0.5 -0.4 -1"
           diffuse="0.8 0.8 0.8" specular="0.25 0.25 0.25" ambient="0.1 0.1 0.1"
           castshadow="true" active="true" bulbradius="0.04" intensity="1.5" range="6"/>
    <light name="lamp" type="point" pos="0.4 0.5 1.2"
           diffuse="0.7 0.5 0.3" specular="0.2 0.2 0.2" ambient="0.02 0.02 0.02"
           attenuation="1 0.12 0.01" cutoff="20" exponent="8"
           castshadow="true" active="true" bulbradius="0.03" intensity="2.5" range="4"/>

    <!-- cam0: top-down. Camera looks along -z of its frame; xyaxes identity
         makes the frame z = +world z, so the view direction is straight down. -->
    <camera name="cam-top" pos="0 0 3.4" xyaxes="1 0 0 0 1 0"
            fovy="45" resolution="320 240" projection="perspective"/>
    <!-- cam1: side view looking at the terrain centre from (+x,-y,+z). -->
    <camera name="cam-side" pos="3.4 -2.6 1.8"
            xyaxes="0.6069 0.7936 0 -0.2857 0.2185 0.9330"
            fovy="40" resolution="240 180" projection="perspective"/>

    <geom name="terrain" type="hfield" hfield="terrain" material="mat-terrain"
          pos="0 0 0" quat="1 0 0 0" group="1"/>
  </worldbody>
</mujoco>
