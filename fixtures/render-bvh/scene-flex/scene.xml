<mujoco model="scene-flex">
  <!-- Render/BVH R06-S3b reference fixture: 1D flex + rigid geometry coexistence.
       First flex rendering reference scene (S3a/S3c device implementation). Same XML must
       compile to equivalent render/flex model arrays with MuJoCo 3.12.0 (product) and
       3.15.0 (reference authoring); parity is recorded in model-312/315.json + provenance.

       Flex constraints (S3b card):
       - 1D flex only in the first window; 2D/3D stay mechanism-only.
       - flex edges must keep >=0.3 clearance from rigid surfaces: flex never wins a
         near-coplanar tie (upstream hit_geom_id = -2, `-2 > geom_id` is false), so the
         scene must not rely on tie results.
       - flex alpha must be != 0 (transparent flex takes the miss path).
       - world isolation assertion: 1D flex vertices live in world coordinates, rigid
         geoms keep their own world pose. -->
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <visual>
    <global fovy="45" offwidth="320" offheight="240"/>
    <quality shadowsize="1024" offsamples="4"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" active="1"/>
    <map znear="0.01" zfar="50" fogstart="1" fogend="10" haze="0.1"/>
  </visual>
  <statistic center="0.1 -0.2 0.3" extent="2.5"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.85 0.15 0.15" rgb2="0.15 0.15 0.85"
             width="64" height="64" colorspace="sRGB"/>
    <texture name="ramp" type="2d" builtin="gradient"
             rgb1="0.2 0.7 0.3" rgb2="0.05 0.1 0.2" width="32" height="32"/>
    <material name="mat-red" texture="grid" texrepeat="2 3" texuniform="false"
              rgba="0.9 0.1 0.1 1" emission="0.05" specular="0.4"
              shininess="0.6" reflectance="0.1" metallic="0.2" roughness="0.3"/>
    <material name="mat-green" texture="ramp" texrepeat="1 1" texuniform="true"
              rgba="0.2 0.8 0.2 1" specular="0.2" shininess="0.1"/>
    <material name="mat-plain" rgba="0.5 0.5 0.55 1" specular="0.1" shininess="0.2"/>
    <mesh name="tri" vertex="0 0 0  0.22 0 0  0 0.18 0.05  0 0 0.2"
          face="0 1 2  0 1 3  1 2 3  0 2 3"/>
  </asset>

  <worldbody>
    <!-- Static anchor bodies for the 1D flex vertices: each flex vertex is bound to a
         distinct body so `flex_rigid` stays false (upstream MJWarp rejects rigid flexes);
         the anchors sit at identity, so world-space flex vertices equal the local values. -->
    <body name="flex-anchor0"/>
    <body name="flex-anchor1"/>
    <body name="flex-anchor2"/>
    <!-- Dedicated target body at the flex cluster center (camera aim only). -->
    <body name="flex-target" pos="-1.0 0.68 0.55"/>
    <light name="sun" type="directional" pos="1 1 3" dir="-0.5 -0.4 -1"
           diffuse="0.8 0.8 0.8" specular="0.25 0.25 0.25" ambient="0.1 0.1 0.1"
           castshadow="true" active="true" bulbradius="0.04" intensity="1.5" range="6"/>
    <light name="lamp" type="point" pos="0.4 0.5 1.2"
           diffuse="0.7 0.5 0.3" specular="0.2 0.2 0.2" ambient="0.02 0.02 0.02"
           attenuation="1 0.12 0.01" cutoff="20" exponent="8"
           castshadow="true" active="true" bulbradius="0.03" intensity="2.5" range="4"/>

    <camera name="cam-persp" pos="1.2 -1.1 0.8" quat="0.9 0.1 -0.2 0.3"
            resolution="320 240" sensorsize="0.036 0.024" focalpixel="160 160"
            projection="perspective"/>
    <camera name="cam-track" mode="targetbody" target="tri_body"
            pos="-0.8 0.9 0.7" fovy="40" resolution="240 180"/>
    <!-- The flex cluster is >=0.3 away from the rigid geometry; this camera guarantees
         flex coverage in the reference (rgb/depth/seg) independently of the rigid framing. -->
    <camera name="cam-flex" mode="targetbody" target="flex-target"
            pos="-0.35 -1.15 1.05" fovy="45" resolution="320 240"/>

    <geom name="floor" type="plane" size="2 2 0.1" material="mat-plain"
          pos="0 0 0" quat="1 0 0 0" group="1" rgba="0.5 0.5 0.55 1"/>
    <body name="base" pos="0.1 -0.2 0.3" quat="0.96 0.1 -0.05 0.25">
      <freejoint name="basefree"/>
      <geom name="base-box" type="box" size="0.18 0.14 0.1" material="mat-red"
            pos="0.05 -0.02 0.03" quat="0.99 0.02 0.05 -0.1" group="2"
            rgba="0.85 0.25 0.2 1"/>
      <body name="tri_body" pos="0.2 0.1 0.25" quat="0.92 -0.1 0.2 0.3">
        <joint name="tri-hinge" type="hinge" pos="0 0 0" axis="0 0 1"/>
        <geom name="tri-mesh" type="mesh" mesh="tri" material="mat-red"
              pos="0 0 0" quat="1 0 0 0" group="3"/>
        <geom name="tri-capsule" type="capsule" size="0.05 0.12"
              pos="0.15 0 0" quat="0.707 0 0.707 0" material="mat-plain" group="1"/>
      </body>
    </body>
  </worldbody>

  <deformable>
    <!-- 1D flex #1: world-space Z line, r=0.02, >=0.3 clearance from rigid geoms/floor. -->
    <flex name="flex-line" dim="1" radius="0.02" rgba="0.9 0.5 0.1 1"
          body="world flex-anchor0 flex-anchor1 flex-anchor2"
          vertex="-1.0 0.6 0.5  -1.15 0.62 0.5  -1.15 0.62 0.68  -1.0 0.6 0.68"
          element="0 1 1 2 2 3"/>
    <!-- 1D flex #2: single fat edge (r=0.04), pure blue, exercises radius/rgba channels. -->
    <flex name="flex-line-fat" dim="1" radius="0.04" rgba="0.2 0.4 0.9 1"
          body="flex-anchor0 flex-anchor1"
          vertex="-0.9 0.9 0.35  -0.8 0.95 0.4"
          element="0 1"/>
  </deformable>
</mujoco>
