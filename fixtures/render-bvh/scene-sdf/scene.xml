<mujoco model="scene-sdf">
  <!-- SDF render reference fixture (group: sdf-mesh).
       Upstream renders SDF geoms via their underlying mesh (render.py L738-761);
       this fixture gives the SDF geom an explicit convex mesh asset so the render
       reference exercises mesh intersection, textures and vertex normals.
       Rendering only: the SDF geom carries contype/conaffinity = 0 so no collision
       pair can reach the SDF narrowphase (volume SDF collisions are out of scope).
       Two cameras (perspective front, top-down) and two shadow-casting lights, so
       the any-hit path sees the SDF geom as well. -->
  <compiler angle="degree"/>
  <option timestep="0.002" gravity="0 0 -9.81" sdf_iterations="10" sdf_initpoints="40"/>
  <visual>
    <global fovy="45" offwidth="320" offheight="240"/>
    <quality shadowsize="1024" offsamples="4"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" active="1"/>
    <map znear="0.01" zfar="50" fogstart="1" fogend="10" haze="0.1"/>
  </visual>
  <statistic center="0 0 0.35" extent="2.5"/>

  <asset>
    <texture name="sdf-tex" type="2d" builtin="checker"
             rgb1="0.85 0.15 0.15" rgb2="0.15 0.15 0.85"
             width="64" height="64" colorspace="sRGB"/>
    <material name="mat-sdf" texture="sdf-tex" texrepeat="2 2" texuniform="false"
              rgba="0.9 0.9 0.9 1" specular="0.3" shininess="0.5"/>
    <material name="mat-plain" rgba="0.5 0.5 0.55 1" specular="0.1" shininess="0.2"/>
    <!-- Convex cube mesh (half extent 0.35). Faces are outward-wound so backface
         culling and the vertex-normal branch are both observable in the reference.
         MuJoCo accepts an explicit face list; SDF volume data uses the enclosing
         mesh, while the renderer intersects these triangles directly. -->
    <mesh name="cube"
          vertex="-0.35 -0.35 -0.35  0.35 -0.35 -0.35  0.35 0.35 -0.35  -0.35 0.35 -0.35  -0.35 -0.35 0.35  0.35 -0.35 0.35  0.35 0.35 0.35  -0.35 0.35 0.35"
          face="0 3 2  0 2 1  4 5 6  4 6 7  0 1 5  0 5 4  3 7 6  3 6 2  1 2 6  1 6 5  0 4 7  0 7 3"/>
  </asset>

  <worldbody>
    <light name="sun" type="directional" pos="1 1 3" dir="-0.5 -0.4 -1"
           diffuse="0.8 0.8 0.8" specular="0.25 0.25 0.25" ambient="0.1 0.1 0.1"
           castshadow="true" active="true" bulbradius="0.04" intensity="1.5" range="6"/>
    <light name="lamp" type="point" pos="0.4 0.5 1.6"
           diffuse="0.7 0.5 0.3" specular="0.2 0.2 0.2" ambient="0.02 0.02 0.02"
           attenuation="1 0.12 0.01" cutoff="20" exponent="8"
           castshadow="true" active="true" bulbradius="0.03" intensity="2.5" range="4"/>

    <camera name="cam-front" pos="1.5 -1.4 1.2"
            xyaxes="0.6827 0.7307 0 -0.4567 0.4266 0.7810"
            fovy="45" resolution="320 240" projection="perspective"/>
    <camera name="cam-top" pos="0 0 3.2" xyaxes="1 0 0 0 1 0"
            fovy="45" resolution="240 180" projection="perspective"/>

    <geom name="floor" type="plane" size="2 2 0.1" material="mat-plain"
          pos="0 0 0" quat="1 0 0 0" group="1"/>
    <geom name="sdf-cube" type="sdf" mesh="cube" material="mat-sdf"
          pos="0 0 0.35" quat="1 0 0 0" group="2"
          contype="0" conaffinity="0"/>
    <geom name="side-sphere" type="sphere" size="0.12" material="mat-plain"
          pos="0.65 0 0.2" group="2"/>
  </worldbody>
</mujoco>
