        "__device__ Q multiply(Q a,Q b) {",
        "return {a.w*b.w-a.x*b.x-a.y*b.y-a.z*b.z,",
        "a.w*b.z+a.x*b.y-a.y*b.x+a.z*b.w};"
      ],
      "upstream": [
        "return wp.quat(",
        "u[0] * v[0] - u[1] * v[1] - u[2] * v[2] - u[3] * v[3],",
        "u[0] * v[3] + u[1] * v[2] - u[2] * v[1] + u[3] * v[0],"
      ]
    },
    {
