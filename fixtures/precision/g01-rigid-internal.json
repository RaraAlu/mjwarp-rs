      "upstream_source": "upstream/_src/math.py",
      "symbol": "rot_vec_quat",
      "upstream_type": "wp.vec3",
      "product": [
        "float d=q.x*v.x+q.y*v.y+q.z*v.z;",
        "float s=q.w*q.w-q.x*q.x-q.y*q.y-q.z*q.z;",
        "return {s*v.x+2*d*q.x+2*q.w*(q.y*v.z-q.z*v.y),"
      ],
      "upstream": [
        "s, u = quat[0], wp.vec3(quat[1], quat[2], quat[3])",
        "r = 2.0 * (wp.dot(u, vec) * u) + (s * s - wp.dot(u, u)) * vec",
        "r = r + 2.0 * s * wp.cross(u, vec)"
      ]
    },
