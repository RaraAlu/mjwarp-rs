<mujoco model="camlight-tree">
  <compiler angle="radian" fusestatic="false"/>
  <default><geom type="sphere" size="0.08" mass="1"/></default>
  <worldbody>
    <camera name="world" pos="2 -3 1" quat="0.5 0.5 0.5 0.5"/>
    <light name="world" pos="-2 3 1" dir="1 2 -3"/>
    <body name="hinge" pos="0.3 -0.4 0.5" quat="0.5 0.5 0.5 0.5">
      <joint type="hinge" axis="0 0 1" ref="0.15"/>
      <geom pos="0.2 0.1 0.3"/>
      <camera name="fixed" pos="1 2 3" quat="0 1 0 0"/>
      <camera name="track" mode="track" pos="-2 3 1"/>
      <camera name="com" mode="trackcom" pos="2 -1 3"/>
      <camera name="target" mode="targetbody" target="slider" pos="1 -2 3"/>
      <camera name="targetcom" mode="targetbodycom" target="mocap" pos="3 2 -1"/>
      <camera name="missing" pos="1 3 2" quat="0.5 0.5 0.5 0.5"/>
      <camera name="missingcom" pos="-1 2 3"/>
      <light name="fixed" pos="-1 2 3" dir="2 -1 3"/>
      <light name="track" mode="track" pos="2 -3 1" dir="-1 2 3"/>
      <light name="com" mode="trackcom" pos="-2 1 3" dir="1 -2 3"/>
      <light name="target" mode="targetbody" target="slider" pos="2 1 3"/>
      <light name="targetcom" mode="targetbodycom" target="mocap" pos="-3 -2 1"/>
      <light name="missing" pos="-1 -3 -2" dir="1 3 -2"/>
      <light name="missingcom" pos="1 -2 -3" dir="1 -2 3"/>
      <body pos="0.5 0.2 -0.1"><geom pos="0.1 0.2 0.3" mass="2"/></body>
    </body>
    <body name="mocap" mocap="true" pos="-0.8 0.7 1.2" quat="0 1 0 0">
      <geom/><body pos="0.3 0.1 0.5"><geom mass="3"/></body>
    </body>
    <body name="slider" pos="0.4 0.3 -0.2">
      <joint type="slide" axis="0 1 0" ref="0.2"/><geom/>
    </body>
  </worldbody>
</mujoco>
