<mujoco model="set-const-qpos">
  <compiler angle="radian"/>
  <option timestep="0.002"/>
  <worldbody>
    <body name="b1" pos="0 0 0.1">
      <joint name="j1" type="ball"/>
      <inertial pos="0 0 0" mass="1.2" diaginertia="0.02 0.03 0.04"/>
      <geom name="g1" type="capsule" size="0.02" fromto="0 0 0 0 0 0.1"/>
      <site name="s1" pos="0 0 0.05"/>
      <camera name="cam0" pos="1 1 1" xyaxes="0 1 0 -1 0 0"/>
      <light name="light0" pos="1 0 3" dir="1 0 -1"/>
    </body>
    <body name="b2" pos="0.2 0 0.1">
      <joint name="j2" type="slide" axis="1 0 0"/>
      <inertial pos="0 0 0" mass="0.8" diaginertia="0.01 0.01 0.01"/>
      <geom name="g2" type="sphere" size="0.03"/>
    </body>
    <camera name="cam1" pos="2 0 1" target="b2"/>
    <light name="light1" pos="1 1 3" dir="0 -1 -1" target="b1"/>
  </worldbody>
  <tendon>
    <fixed name="t1"><joint joint="j2" coef="1.5"/></fixed>
  </tendon>
</mujoco>
