<mujoco model="integrator_input">
  <option timestep="0.01" gravity="0 0 0" integrator="Euler"/>
  <worldbody>
    <body name="free_body" pos="0 0 1">
      <freejoint name="free_joint"/>
      <geom name="free_geom" type="sphere" size="0.1"/>
    </body>
    <body name="ball_body" pos="1 0 1">
      <joint name="ball_joint" type="ball"/>
      <geom name="ball_geom" type="capsule" size="0.05 0.1"/>
    </body>
    <body name="hinge_body" pos="2 0 1">
      <joint name="hinge_joint" type="hinge" axis="0 0 1"/>
      <geom name="hinge_geom" type="capsule" size="0.05 0.1"/>
    </body>
    <body name="slide_body" pos="3 0 1">
      <joint name="slide_joint" type="slide" axis="1 0 0"/>
      <geom name="slide_geom" type="box" size="0.1 0.1 0.1"/>
    </body>
  </worldbody>
</mujoco>
