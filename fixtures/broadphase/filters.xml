<mujoco model="broadphase_filter_input">
  <option timestep="0.002" gravity="0 0 0"/>
  <worldbody>
    <light name="key_light" type="directional" pos="0 0 1"/>
    <geom name="floor" type="plane" size="10 10 0.001"/>
    <body name="green" pos="0 0 0">
      <geom name="green_capsule" type="capsule" size="0.05 0.1"/>
      <joint name="green_x" type="slide" axis="1 0 0"/>
      <joint name="green_z" type="slide" axis="0 0 1"/>
      <joint name="green_yaw" type="hinge" axis="0 1 0"/>
    </body>
    <body name="red" pos="0 0 0">
      <geom name="red_capsule" type="capsule" size="0.05 0.1"/>
      <joint name="red_x" type="slide" axis="1 0 0"/>
      <joint name="red_z" type="slide" axis="0 0 1"/>
      <joint name="red_yaw" type="hinge" axis="0 1 0"/>
    </body>
  </worldbody>
  <keyframe>
    <key name="apart" qpos="-0.5 0.25 0 0.5 0.25 0"/>
    <key name="one_touch" qpos="-0.5 0.075 1.57 0.5 0.25 0"/>
    <key name="near" qpos="-0.075 0.25 0 0.075 0.25 0"/>
    <key name="rotated" qpos="0 0.25 0.7853 0 0.45 0.7853"/>
  </keyframe>
</mujoco>
