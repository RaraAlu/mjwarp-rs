<mujoco model="spatial-tendon-reference">
  <compiler angle="radian"/>
  <option jacobian="sparse"/>
  <default><geom type="sphere" size="0.08" mass="1"/></default>
  <worldbody>
    <site name="world-a" pos="-0.3 0.2 0.1"/>
    <site name="world-b" pos="1.2 -0.1 0.3"/>
    <body name="free" pos="0.2 -0.1 1">
      <freejoint name="free-joint"/><geom/>
      <site name="free-site" pos="0.2 0.1 -0.1"/>
      <body name="ball" pos="0 0 0.2">
        <joint name="ball-joint" type="ball"/><geom/>
        <site name="ball-site" pos="0.1 -0.1 0.1"/>
        <body name="hinge-a" pos="0.1 0.2 0.1">
          <joint name="hinge-a" type="hinge" axis="0 1 0" ref="0.4"/><geom/>
          <site name="a0" pos="0.1 0 0"/><site name="a1" pos="-0.1 0.2 0.1"/>
          <body name="hinge-b" pos="0.2 0 0">
            <joint name="hinge-b" type="hinge" axis="1 0 0" ref="-0.3"/><geom/>
            <site name="b" pos="0.1 0.1 0.2"/>
          </body>
        </body>
      </body>
    </body>
    <body name="slide" pos="-0.2 0.3 0.7">
      <joint name="slide" type="slide" axis="0 0 1" ref="0.15"/><geom/>
      <site name="slide-site" pos="0.1 0.1 0.1"/>
    </body>
    <body name="mocap" mocap="true" pos="0.6 0.5 0.7">
      <geom/><site name="mocap-site" pos="0.1 -0.2 0.3"/>
    </body>
  </worldbody>
  <tendon>
    <spatial name="long"><site site="world-a"/><site site="a0"/><site site="b"/><site site="slide-site"/><site site="mocap-site"/></spatial>
    <spatial name="same-body"><site site="a0"/><site site="a1"/></spatial>
    <spatial name="pulley"><pulley divisor="2"/><site site="world-a"/><site site="b"/><pulley divisor="4"/><site site="slide-site"/><site site="mocap-site"/><site site="ball-site"/></spatial>
    <spatial name="shared-root"><site site="free-site"/><site site="b"/><site site="ball-site"/></spatial>
    <spatial name="static"><site site="world-a"/><site site="world-b"/></spatial>
  </tendon>
</mujoco>
