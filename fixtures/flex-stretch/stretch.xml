<mujoco model="flex-stretch">
  <option gravity="0 0 0"/>
  <worldbody>
    <flexcomp name="nodes" type="grid" dim="3" count="3 3 3" spacing="0.2 0.3 0.4" pos="0 2 0" dof="trilinear" mass="2">
      <contact selfcollide="none" internal="false"/>
    </flexcomp>
    <flexcomp name="sheet" type="grid" dim="2" count="3 2 1" spacing="0.3 0.4 0.5" mass="2">
      <contact selfcollide="none" internal="false"/>
      <elasticity young="10" poisson="0.2" thickness="0.05"/>
    </flexcomp>
    <flexcomp name="solid" type="grid" dim="3" count="2 2 2" spacing="0.3 0.4 0.5" pos="2 0 0" mass="2">
      <contact selfcollide="none" internal="false"/>
      <elasticity young="10" poisson="0.2"/>
    </flexcomp>
    <flexcomp name="line" type="grid" dim="1" count="3 1 1" spacing="0.3 0.4 0.5" pos="4 0 0" mass="1">
      <contact selfcollide="none" internal="false"/>
    </flexcomp>
  </worldbody>
  <deformable>
    <flex name="rigid" dim="2" body="world" vertex="0 4 0 1 4 0 0 5 0" element="0 1 2">
      <contact selfcollide="none" internal="false"/>
    </flex>
  </deformable>
</mujoco>
