<mujoco model="flex-position">
  <option gravity="0 0 0"/>
  <default><geom contype="0" conaffinity="0"/></default>
  <worldbody>
    <body name="rotor" pos="0.2 -0.3 0.4" euler="10 20 30">
      <joint name="hinge" axis="0 0 1"/>
      <inertial mass="1" pos="0.1 0 0" diaginertia="0.1 0.1 0.1"/>
      <site name="moving" pos="0.4 0.1 0"/>
      <flexcomp name="linear" type="grid" dim="3" count="5 3 3" cellcount="2 1 1" spacing="0.2 0.3 0.4" pos="1 0 0" dof="trilinear" mass="2">
        <contact selfcollide="none" internal="false"/>
      </flexcomp>
    </body>
    <body name="slider" pos="1.3 0.2 -0.1">
      <joint name="slide" type="slide" axis="1 0 0"/>
      <inertial mass="1" pos="0 0 0" diaginertia="0.1 0.1 0.1"/>
    </body>
    <body name="ball" pos="-0.8 0.4 0.2">
      <joint name="balljoint" type="ball"/>
      <inertial mass="1" pos="0 0 0" diaginertia="0.1 0.1 0.1"/>
    </body>
    <body name="tracked" mocap="true" pos="0.5 0.7 0.2"><site name="tracked-site"/></body>
    <flexcomp name="linear-centered" type="grid" dim="3" count="3 3 3" spacing="0.3 0.3 0.3" pos="0 2 0" dof="trilinear" mass="2">
      <contact selfcollide="none" internal="false"/>
    </flexcomp>
  </worldbody>
  <deformable>
    <flex name="offset" dim="1" body="world rotor slider tracked ball" vertex="-0.4 0 0 0.1 0.2 0.3 -0.2 0 0 0.1 -0.1 0.2 0 0.3 0" element="0 1 1 2 2 3 3 4"/>
    <flex name="centered" dim="1" body="rotor slider tracked" vertex="0 0 0 0 0 0 0 0 0" element="0 1 1 2"/>
  </deformable>
  <tendon>
    <fixed><joint joint="hinge" coef="1.7"/><joint joint="slide" coef="-0.4"/></fixed>
    <spatial><site site="moving"/><site site="tracked-site"/></spatial>
  </tendon>
</mujoco>
